#!/bin/sh
# Build a .kuzpkg.tar.zst package from a PKGBUILD-compatible .proto file.
#
# This helper delegates package creation to kuzpkg/makepkg so Buildroot uses
# the same package format and metadata rules as Kuznix.

set -eu

usage() {
	cat >&2 <<'EOF'
usage: kuzpkg-build --target DIR --output DIR --proto FILE \
	--pkgname NAME --pkgver VERSION --arch ARCH --url URL --desc DESCRIPTION \
	[--file-list FILE] [--makepkg PATH]
EOF
	exit 2
}

TARGET_DIR=
OUTPUT_DIR=
PROTO=
FILE_LIST=
PKGNAME=
PKGVER=
ARCH=
URL=
DESC=
MAKEPKG=makepkg

while [ "$#" -gt 0 ]; do
	case "$1" in
		--target) TARGET_DIR=${2:?missing argument for --target}; shift 2 ;;
		--output) OUTPUT_DIR=${2:?missing argument for --output}; shift 2 ;;
		--proto) PROTO=${2:?missing argument for --proto}; shift 2 ;;
		--file-list) FILE_LIST=${2:?missing argument for --file-list}; shift 2 ;;
		--pkgname) PKGNAME=${2:?missing argument for --pkgname}; shift 2 ;;
		--pkgver) PKGVER=${2:?missing argument for --pkgver}; shift 2 ;;
		--arch) ARCH=${2:?missing argument for --arch}; shift 2 ;;
		--url) URL=${2:?missing argument for --url}; shift 2 ;;
		--desc) DESC=${2:?missing argument for --desc}; shift 2 ;;
		--makepkg) MAKEPKG=${2:?missing argument for --makepkg}; shift 2 ;;
		-h|--help) usage ;;
		*) echo "kuzpkg-build: unknown option: $1" >&2; usage ;;
	esac
done

[ -n "$TARGET_DIR" ] || { echo "kuzpkg-build: --target is required" >&2; usage; }
[ -n "$OUTPUT_DIR" ] || { echo "kuzpkg-build: --output is required" >&2; usage; }
[ -n "$PROTO" ] || { echo "kuzpkg-build: --proto is required" >&2; usage; }
[ -n "$PKGNAME" ] || { echo "kuzpkg-build: --pkgname is required" >&2; usage; }
[ -n "$PKGVER" ] || { echo "kuzpkg-build: --pkgver is required" >&2; usage; }
[ -n "$ARCH" ] || { echo "kuzpkg-build: --arch is required" >&2; usage; }
[ -n "$URL" ] || { echo "kuzpkg-build: --url is required" >&2; usage; }
[ -n "$DESC" ] || { echo "kuzpkg-build: --desc is required" >&2; usage; }

[ -d "$TARGET_DIR" ] || { echo "kuzpkg-build: target directory does not exist: $TARGET_DIR" >&2; exit 1; }
[ -f "$PROTO" ] || { echo "kuzpkg-build: proto file does not exist: $PROTO" >&2; exit 1; }
[ -z "$FILE_LIST" ] || [ -f "$FILE_LIST" ] || {
	echo "kuzpkg-build: file list does not exist: $FILE_LIST" >&2
	exit 1
}
[ -x "$MAKEPKG" ] || command -v "$MAKEPKG" >/dev/null 2>&1 || {
	echo "kuzpkg-build: makepkg not found: $MAKEPKG" >&2
	exit 1
}

mkdir -p "$OUTPUT_DIR"
work=$(mktemp -d "${TMPDIR:-/tmp}/kuzpkg-build.XXXXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM

# Treat the proto as a template instead of sourcing it. This keeps metadata
# substitution deterministic and prevents arbitrary proto code from running
# in the Buildroot shell.
sed \
	-e "s|@PKGNAME@|$(printf '%s' "$PKGNAME" | sed 's/[\\&|]/\\&/g')|g" \
	-e "s|@PKGVER@|$(printf '%s' "$PKGVER" | sed 's/[\\&|]/\\&/g')|g" \
	-e "s|@ARCH@|$(printf '%s' "$ARCH" | sed 's/[\\&|]/\\&/g')|g" \
	-e "s|@URL@|$(printf '%s' "$URL" | sed 's/[\\&|]/\\&/g')|g" \
	-e "s|@PKGDESC@|$(printf '%s' "$DESC" | sed 's/[\\&|]/\\&/g')|g" \
	-e "s|@TARGET_DIR@|$(printf '%s' "$TARGET_DIR" | sed 's/[\\&|]/\\&/g')|g" \
	-e "s|@FILE_LIST@|$(printf '%s' "$work/files.list" | sed 's/[\\&|]/\\&/g')|g" \
	"$PROTO" > "$work/PKGBUILD"

if [ -n "$FILE_LIST" ]; then
	# Build a package-specific root from Buildroot's per-package file list.
	# The list is generated after the package's target-install hooks and has
	# the package name before the first comma, followed by a target-relative
	# path. tar preserves symlinks and file metadata while avoiding an entire
	# copy of TARGET_DIR for every package.
	cut -d, -f2- "$FILE_LIST" > "$work/files.list"
	mkdir -p "$work/pkgroot"
	(
		cd "$TARGET_DIR"
		tar -cf - -T "$work/files.list"
	) | tar -C "$work/pkgroot" -xf -
	TARGET_DIR="$work/pkgroot"
	# The generated PKGBUILD reads this variable through the substituted path.
	sed -i "s|@TARGET_DIR@|$(printf '%s' "$TARGET_DIR" | sed 's/[\\&|]/\\&/g')|g" "$work/PKGBUILD"
fi

cd "$work"
"$MAKEPKG" -f --nodeps --noconfirm

found=0
for package in "$work"/*.kuzpkg.tar.zst; do
	[ -e "$package" ] || continue
	mv "$package" "$OUTPUT_DIR/"
	printf '%s\n' "$OUTPUT_DIR/$(basename "$package")"
	found=1
done

[ "$found" -eq 1 ] || {
	echo "kuzpkg-build: makepkg produced no .kuzpkg.tar.zst package" >&2
	exit 1
}
