#!/bin/sh
# Build a .kuzpkg.tar.zst package from a PKGBUILD-compatible .proto file.
#
# This helper intentionally delegates package creation to kuzpkg/makepkg so
# Buildroot uses the same package format and metadata rules as Kuznix.

set -eu

usage() {
	cat >&2 <<'EOF'
usage: kuzpkg-build --target DIR --output DIR --proto FILE \
	--pkgname NAME --pkgver VERSION --arch ARCH --url URL --desc DESCRIPTION \
	[--makepkg PATH]
EOF
	exit 2
}

TARGET_DIR=
OUTPUT_DIR=
PROTO=
PKGNAME=
PKGVER=
ARCH=
URL=
DESC=
MAKEPKG=makepkg

while [ "$#" -gt 0 ]; do
	case "$1" in
		--target) TARGET_DIR=${2:?missing argument for --target}; shift 2 ;;
		--output) OUTPUT_DIR=${2:?missing argument for --output}; shift 2 ;;
		--proto) PROTO=${2:?missing argument for --proto}; shift 2 ;;
		--pkgname) PKGNAME=${2:?missing argument for --pkgname}; shift 2 ;;
		--pkgver) PKGVER=${2:?missing argument for --pkgver}; shift 2 ;;
		--arch) ARCH=${2:?missing argument for --arch}; shift 2 ;;
		--url) URL=${2:?missing argument for --url}; shift 2 ;;
		--desc) DESC=${2:?missing argument for --desc}; shift 2 ;;
		--makepkg) MAKEPKG=${2:?missing argument for --makepkg}; shift 2 ;;
		-h|--help) usage ;;
		*) echo "kuzpkg-build: unknown option: $1" >&2; usage ;;
	esac
done

for var in TARGET_DIR OUTPUT_DIR PROTO PKGNAME PKGVER ARCH URL DESC; do
	eval "value=\${$var}"
	[ -n "$value" ] || { echo "kuzpkg-build: missing --${var#TARGET_DIR}" >&2; usage; }
done

[ -d "$TARGET_DIR" ] || { echo "kuzpkg-build: target directory does not exist: $TARGET_DIR" >&2; exit 1; }
[ -f "$PROTO" ] || { echo "kuzpkg-build: proto file does not exist: $PROTO" >&2; exit 1; }
[ -x "$MAKEPKG" ] || command -v "$MAKEPKG" >/dev/null 2>&1 || {
	echo "kuzpkg-build: makepkg not found: $MAKEPKG" >&2
	exit 1
}

mkdir -p "$OUTPUT_DIR"
work=$(mktemp -d "${TMPDIR:-/tmp}/kuzpkg-build.XXXXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM

# The proto is deliberately treated as a template, not sourced. This keeps
# package generation deterministic and prevents metadata from executing in
# the Buildroot shell.
sed \
	-e "s|@PKGNAME@|$(printf '%s' "$PKGNAME" | sed 's/[\\&|]/\\&/g')|g" \
	-e "s|@PKGVER@|$(printf '%s' "$PKGVER" | sed 's/[\\&|]/\\&/g')|g" \
	-e "s|@ARCH@|$(printf '%s' "$ARCH" | sed 's/[\\&|]/\\&/g')|g" \
	-e "s|@URL@|$(printf '%s' "$URL" | sed 's/[\\&|]/\\&/g')|g" \
	-e "s|@PKGDESC@|$(printf '%s' "$DESC" | sed 's/[\\&|]/\\&/g')|g" \
	-e "s|@TARGET_DIR@|$(printf '%s' "$TARGET_DIR" | sed 's/[\\&|]/\\&/g')|g" \
	"$PROTO" > "$work/PKGBUILD"

cd "$work"
"$MAKEPKG" -f --nodeps --noconfirm --packagelist > "$work/package-list"
"$MAKEPKG" -f --nodeps --noconfirm

while IFS= read -r package; do
	[ -n "$package" ] || continue
	mv "$package" "$OUTPUT_DIR/"
done < "$work/package-list"

cat "$work/package-list"
